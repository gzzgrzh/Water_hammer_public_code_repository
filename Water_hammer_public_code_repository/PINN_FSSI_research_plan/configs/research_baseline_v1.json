    "coefficient_model": "printed_equations"
  },
  "initial_conditions": {
    "fluid_velocity": "V(x,0)=V0",
    "pipe_velocity": "uz(x,0)=0",
    "pressure": "P(x,0)=P0=rho_f*g*DeltaH",
