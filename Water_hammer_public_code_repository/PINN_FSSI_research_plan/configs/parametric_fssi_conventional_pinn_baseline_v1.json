  "loss_weights": {
    "pde": 0.25,
    "valve_dynamic": 0.25,
    "training_anchor": 8.0
  },
  "anchor_objective": {
    "tail_fraction": 0.10,
    "tail_weight": 1.0,
    "selection_and_labels_identical_to": "parametric_fssi_hybrid_formal_v4_peak_enriched"
  },
  "training": {
    "smoke": {
      "epochs": 2,
      "case_limit": 4,
      "case_batch_size": 4,
      "pde_points_per_case": 32,
      "boundary_points_per_case": 16,
      "learning_rate": 0.00006,
      "gradient_clip": 100.0,
      "log_every": 1,
      "checkpoint_every": 2,
      "seed": 29041,
      "dtype": "float64",
      "device": "auto"
    },
    "formal": {
      "epochs": 600,
      "case_limit": 72,
      "case_batch_size": 12,
      "pde_points_per_case": 256,
      "boundary_points_per_case": 64,
      "learning_rate": 0.00006,
      "gradient_clip": 100.0,
      "log_every": 25,
      "checkpoint_every": 100,
      "seed": 29041,
      "dtype": "float64",
      "device": "auto"
    }
  },
  "evaluation": {
    "stage": "formal",
    "splits": ["validation", "test"],
    "batch_size": 8192,
    "test_is_read_once_after_the_frozen_600_epoch_run": true
  },
  "acceptance": {
    "validation_pressure_nrmse": 0.02,
    "validation_axial_stress_nrmse": 0.03,
    "validation_pressure_peak_relative_error": 0.03,
    "validation_stress_peak_relative_error": 0.05
