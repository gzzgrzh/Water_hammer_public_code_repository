{
  "schema_version": 1,
  "model_id": "parametric_fssi_conventional_full_domain_pinn_v1",
  "status": "registered_before_smoke_and_formal_training",
  "paper_route": "PAPER_IDEA_1_PARAMETRIC_PHYSICS_INFORMED_FSSI_2026-08-13.md",
  "design_config": "PINN_FSSI_research_plan/configs/parametric_fssi_forward_v1.json",
  "anchor_config": "PINN_FSSI_research_plan/configs/parametric_fssi_hybrid_formal_v4_peak_enriched.json",
  "reference_root": "PINN_FSSI_research_plan/outputs/parametric_fssi_reference_v1/formal",
  "method": "conventional_parametric_full_space_time_pinn_with_identical_training_anchors",
  "comparison_purpose": "Single preregistered conventional PINN baseline for the characteristic physics-guided surrogate.",
  "network": {
    "inputs": ["x_over_L", "t_over_T", "log_Es_over_E", "closure_time_over_L_cf", "initial_velocity_m_s"],
